{
  "name": "sistema-facturacion",
  "version": "1.0.0",
  "description": "Sistema de facturación electrónica B2B",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "dev:contador": "concurrently \"npm run dev:vite\" \"npm run dev:electron:contador\"",
    "dev:empresa": "concurrently \"npm run dev:vite\" \"npm run dev:electron:empresa\"",
    "dev:personaA": "concurrently \"npm run dev:vite\" \"npm run dev:electron:personaA\"",
    "dev:personaB": "concurrently \"npm run dev:vite\" \"npm run dev:electron:personaB\"",
    "dev:electron:contador": "wait-on http://localhost:5173 && cross-env NODE_ENV=development DEV_PROFILE=contador electron .",
    "dev:electron:empresa": "wait-on http://localhost:5173 && cross-env NODE_ENV=development DEV_PROFILE=empresa electron .",
    "dev:electron:personaA": "wait-on http://localhost:5173 && cross-env NODE_ENV=development DEV_PROFILE=personaA electron .",
    "dev:electron:personaB": "wait-on http://localhost:5173 && cross-env NODE_ENV=development DEV_PROFILE=personaB electron .",
    "seed:all": "node scripts/seed-profiles.js",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "start": "electron .",
    "reset": "bash scripts/reset-dev.sh",
    "check-api": "node scripts/check-api.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:full": "node scripts/test-with-full-output.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:api": "node --experimental-vm-modules node_modules/jest/bin/jest.js __tests__/api",
    "test:report": "cat ../logs/test-results-latest.md",
    "clean:logs": "find ../logs -name 'test-results-2*.md' -delete && echo '✅ Logs antiguos eliminados'"
  },
  "keywords": [
    "facturacion",
    "electron",
    "chile",
    "sii"
  ],
  "author": "Demian Maturana",
  "license": "UNLICENSED",
  "dependencies": {
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^9.2.2",
    "chart.js": "^4.5.1",
    "electron-store": "^11.0.2",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^5.0.2",
    "keytar": "^7.9.0",
    "node-fetch": "^2.7.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.10.1",
    "react-select": "^5.10.2",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "cl.facturacion.app",
    "productName": "Sistema Facturacion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-renderer/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
